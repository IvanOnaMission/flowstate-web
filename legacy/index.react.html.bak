<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Flowstate — AI Systems for NZ Trade Businesses</title>
<meta name="description" content="We build AI systems to save NZ electrical companies time. Quoting, lead follow-ups, admin — automated, so you can focus on the work. 4 weeks to your first live automation." />
<meta name="author" content="Ivan Barnett" />
<link rel="canonical" href="https://flowstate.net.nz/" />

<meta property="og:type" content="website" />
<meta property="og:url" content="https://flowstate.net.nz/" />
<meta property="og:title" content="Flowstate — AI Systems for NZ Trade Businesses" />
<meta property="og:description" content="AI systems that save NZ electrical companies time. Get your evenings back." />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Flowstate — AI Systems for NZ Trade Businesses" />
<meta name="twitter:description" content="AI systems that save NZ electrical companies time. Get your evenings back." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
<style>
/* Flowstate — shared tokens */

:root {
  --bd-bg: #0B0E14;
  --bd-bg-elev: #131418;
  --bd-line: #1F2026;
  --bd-line-strong: #2A2C34;
  --bd-fg: #F4F4F2;
  --bd-fg-mute: #A1A2A8;
  --bd-fg-dim: #6E6F77;
  --bd-accent: #0096FF;
  --bd-accent-ink: #0A0C12;
  --bd-warn: #0096FF;
  --bd-good: #0096FF;

  --bd-font-display: "Geist", "Söhne", "Helvetica Neue", system-ui, sans-serif;
  --bd-font-body: "Geist", "Söhne", "Helvetica Neue", system-ui, sans-serif;
  --bd-font-mono: "Geist Mono", "JetBrains Mono", ui-monospace, monospace;
  --bd-font-editorial: "Instrument Serif", "Times New Roman", serif;
}

.bd-root {
  background: var(--bd-bg);
  color: var(--bd-fg);
  font-family: var(--bd-font-body);
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "ss01", "cv11";
  letter-spacing: -0.005em;
}

/* Mono utility */
.bd-mono {
  font-family: var(--bd-font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--bd-fg-mute);
}

/* Buttons */
.bd-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  border-radius: 8px;
  font-family: var(--bd-font-display);
  font-weight: 600;
  font-size: 15px;
  letter-spacing: -0.01em;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: transform .15s ease, background .15s ease;
}
.bd-btn-primary {
  background: var(--bd-accent);
  color: var(--bd-accent-ink);
}
.bd-btn-primary:hover { transform: translateY(-1px); }
.bd-btn-ghost {
  background: transparent;
  color: var(--bd-fg);
  border: 1px solid var(--bd-line-strong);
}
.bd-btn-ghost:hover { background: var(--bd-bg-elev); }

/* Subtle dot grid bg */
.bd-grid-bg {
  background-image:
    radial-gradient(circle at 1px 1px, rgba(255,255,255,0.06) 1px, transparent 0);
  background-size: 28px 28px;
}

/* Hairline */
.bd-rule { height: 1px; background: var(--bd-line); width: 100%; }

/* Tag chip */
.bd-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border: 1px solid var(--bd-line-strong);
  border-radius: 999px;
  font-family: var(--bd-font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--bd-fg-mute);
}
.bd-tag .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--bd-accent);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--bd-accent) 25%, transparent);
}

/* Image placeholder */
.bd-placeholder {
  background:
    repeating-linear-gradient(135deg,
      rgba(255,255,255,0.025) 0 12px,
      rgba(255,255,255,0.05) 12px 24px);
  border: 1px solid var(--bd-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--bd-font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--bd-fg-dim);
}

/* Sections */
.bd-section { padding: 100px 64px; }
.bd-section-tight { padding: 64px 64px; }

/* Headings */
.bd-h1 {
  font-family: var(--bd-font-display);
  font-weight: 600;
  font-size: 88px;
  line-height: 0.95;
  letter-spacing: -0.035em;
  margin: 0;
}
.bd-h2 {
  font-family: var(--bd-font-display);
  font-weight: 600;
  font-size: 56px;
  line-height: 1.0;
  letter-spacing: -0.03em;
  margin: 0;
}
.bd-h3 {
  font-family: var(--bd-font-display);
  font-weight: 600;
  font-size: 28px;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0;
}

/* No-scroll inside artboards */
html, body { background: #1A1A1C; }

:root {
  --bd-accent: #0096FF;
  --bd-accent-ink: #FFFFFF;
}
html, body { margin: 0; padding: 0; background: var(--bd-bg); }
body { display: flex; justify-content: center; }
#root { width: 1280px; max-width: 100%; min-height: 100vh; }

/* ============================================ */
/* MOBILE OVERRIDES — screens under 820px       */
/* ============================================ */
@media (max-width: 820px) {
  html, body {
    overflow-x: hidden !important;
    width: 100% !important;
    max-width: 100vw !important;
  }
  body { display: block !important; }
  #root {
    width: 100% !important;
    max-width: 100vw !important;
    overflow-x: hidden !important;
  }
  /* Anything inside root: never wider than the screen */
  #root *, #root *:before, #root *:after {
    max-width: 100vw !important;
    box-sizing: border-box !important;
  }

  /* NAV — keep slim and horizontal on mobile */
  .bd-nav {
    flex-direction: row !important;
    padding: 12px 16px !important;
    align-items: center !important;
  }
  .bd-nav-brand {
    flex-direction: row !important;
    gap: 10px !important;
    align-items: center !important;
  }
  .bd-nav-links {
    flex-direction: row !important;
    gap: 14px !important;
    align-items: center !important;
  }
  /* Hide the desktop link list on mobile — keep only the Book a call button */
  .bd-nav-links .bd-mono { display: none !important; }
  .bd-nav-cta {
    width: auto !important;
    padding: 8px 14px !important;
    font-size: 12px !important;
  }

  /* Section padding */
  .bd-section { padding: 56px 20px !important; }
  .bd-section-tight { padding: 40px 20px !important; }

  /* Headings */
  .bd-h1 { font-size: 32px !important; line-height: 1.05 !important; letter-spacing: -0.02em !important; }
  .bd-h2 { font-size: 26px !important; line-height: 1.1 !important; }
  .bd-h3 { font-size: 20px !important; }

  /* Buttons — full width, easier to tap */
  .bd-btn {
    padding: 16px 22px !important;
    font-size: 16px !important;
    width: 100% !important;
    justify-content: center !important;
  }

  /* Force any inline grid container to stack vertically */
  [style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }

  /* Force any inline flex row to stack vertically */
  [style*="display: flex"][style*="gap"]:not([style*="flex-direction: column"]) {
    flex-direction: column !important;
    align-items: stretch !important;
  }

  /* Reduce inline padding (e.g., "padding: 100px 64px" or similar) */
  [style*="padding: 100px"], [style*="padding:100px"],
  [style*="padding: 80px"], [style*="padding:80px"],
  [style*="padding: 64px"], [style*="padding:64px"] {
    padding: 40px 20px !important;
  }

  /* Inline font sizes — cap them so the desktop 60-100px headlines don't blow up */
  [style*="fontSize: 80"], [style*="font-size: 80"],
  [style*="fontSize: 88"], [style*="font-size: 88"],
  [style*="fontSize: 96"], [style*="font-size: 96"],
  [style*="fontSize: 100"], [style*="font-size: 100"],
  [style*="fontSize: 110"], [style*="font-size: 110"] {
    font-size: 38px !important;
    line-height: 1.05 !important;
  }
  [style*="fontSize: 60"], [style*="font-size: 60"],
  [style*="fontSize: 64"], [style*="font-size: 64"],
  [style*="fontSize: 72"], [style*="font-size: 72"] {
    font-size: 30px !important;
    line-height: 1.1 !important;
  }
  [style*="fontSize: 40"], [style*="font-size: 40"],
  [style*="fontSize: 44"], [style*="font-size: 44"],
  [style*="fontSize: 48"], [style*="font-size: 48"] {
    font-size: 24px !important;
    line-height: 1.2 !important;
  }
  [style*="fontSize: 32"], [style*="font-size: 32"],
  [style*="fontSize: 36"], [style*="font-size: 36"] {
    font-size: 20px !important;
    line-height: 1.25 !important;
  }
  [style*="fontSize: 24"], [style*="font-size: 24"],
  [style*="fontSize: 28"], [style*="font-size: 28"] {
    font-size: 17px !important;
    line-height: 1.4 !important;
  }
  [style*="fontSize: 19"], [style*="font-size: 19"],
  [style*="fontSize: 20"], [style*="font-size: 20"],
  [style*="fontSize: 22"], [style*="font-size: 22"] {
    font-size: 15px !important;
    line-height: 1.5 !important;
  }

  /* Cap inline maxWidth that exceeds viewport */
  [style*="maxWidth: 1100"], [style*="max-width: 1100"],
  [style*="maxWidth: 1000"], [style*="max-width: 1000"],
  [style*="maxWidth: 900"],  [style*="max-width: 900"],
  [style*="maxWidth: 800"],  [style*="max-width: 800"],
  [style*="maxWidth: 760"],  [style*="max-width: 760"],
  [style*="maxWidth: 720"],  [style*="max-width: 720"] {
    max-width: 100% !important;
  }

  /* Tables / comparison cards: allow horizontal scroll if needed */
  table, .bd-compare {
    display: block !important;
    overflow-x: auto !important;
    width: 100% !important;
  }

  /* Images and placeholders fill width */
  img, .bd-placeholder { max-width: 100% !important; height: auto !important; }
}

/* Hero background video */
.hero-header > *:not(.hero-bg):not(.hero-overlay) { position: relative; z-index: 2; }
.hero-bg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; z-index: 0;
}
.hero-overlay {
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(180deg,
    rgba(8,10,14,0.72) 0%,
    rgba(8,10,14,0.82) 55%,
    var(--bd-bg) 100%);
}

@media (max-width: 820px){ .bd-nav-brand img { height: 40px !important; } }

/* ===== Flowstate mobile overflow fix ===== */
@media (max-width: 820px){
  html, body { overflow-x: hidden !important; }
  #root, .bd-root, .bd-root.v1 { width: 100% !important; max-width: 100% !important; }
  .bd-root *:not(.hero-bg) { max-width: 100% !important; box-sizing: border-box !important; }
  /* hero + CTA never got mobile padding in the original */
  .hero-header { padding: 92px 20px 56px !important; }
  #cta.bd-grid-bg { padding: 72px 20px !important; }
  /* stack every multi-column grid */
  [style*="grid-template-columns"] { grid-template-columns: 1fr !important; gap: 16px !important; }
  /* headline sizes that fit a phone */
  .bd-h1 { font-size: 28px !important; line-height: 1.08 !important; }
  .bd-h2 { font-size: 23px !important; line-height: 1.12 !important; }
  .bd-root h1, .bd-root h2, .bd-root h3, .bd-root p, .bd-root li, .bd-root .bd-mono {
    overflow-wrap: anywhere !important; word-break: normal !important;
  }
  /* nav: keep logo + button tidy */
  .bd-nav { padding: 12px 16px !important; gap: 10px !important; }
  .bd-nav-cta { font-size: 12px !important; padding: 8px 12px !important; white-space: nowrap !important; }
}

/* mobile: let grid/flex items actually shrink to fit */
@media (max-width: 820px){
  .bd-root *:not(.hero-bg){ min-width: 0 !important; }
}
</style>
<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin="anonymous"></script>
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>
</head>
<body>
<div id="root"></div>

<script type="text/babel">
// V1 — "Operator" — Stripe-sharp. Structured, dot grid, blue accent, mono labels.

const V1 = ({ heroCopy }) => {
  const HERO = heroCopy || {
    eyebrow: "AI Automation Agency · Auckland NZ",
    h1: ["Your business runs you.", "Let's flip that."],
    sub: "We build AI systems to save NZ electrical companies time. Quoting, lead follow-ups, admin — automated, so you can focus on the work."
  };

  return (
    <div className="bd-root v1" style={{ width: 1280 }}>
      {/* NAV */}
      <div className="bd-nav" style={{
        display: "flex", alignItems: "center", justifyContent: "space-between",
        padding: "24px 64px", borderBottom: "1px solid var(--bd-line)",
        background: "#0E0F12"
      }}>
        <div className="bd-nav-brand" style={{ display: "flex", alignItems: "center" }}><img src="data:image/svg+xml;base64," alt="Flowstate" style={{ height: 50, display: "block" }} /></div>
        <div className="bd-nav-links" style={{ display: "flex", gap: 32, alignItems: "center" }}>
          <a href="#work" className="bd-mono" style={{ textDecoration: "none", cursor: "pointer" }}>WORK</a>
          <a href="#process" className="bd-mono" style={{ textDecoration: "none", cursor: "pointer" }}>PROCESS</a>
          <a href="#about" className="bd-mono" style={{ textDecoration: "none", cursor: "pointer" }}>ABOUT</a>
          <a href="#" onClick={(e) => { e.preventDefault(); window.Calendly && window.Calendly.initPopupWidget({ url: 'https://calendly.com/barnettdigital/discovery_call' }); }} className="bd-btn bd-btn-primary bd-nav-cta" style={{ padding: "10px 16px", fontSize: 13 }}>
            Book a call →
          </a>
        </div>
      </div>

      {/* HERO */}
      <div className="bd-grid-bg hero-header" style={{ padding: "120px 64px 140px", position: "relative", overflow: "hidden" }}>
        <video className="hero-bg" autoPlay muted loop playsInline src="assets/hero.mp4" />
        <div className="hero-overlay" />
        <div className="bd-tag" style={{ marginBottom: 32 }}>
          <span className="dot" /> {HERO.eyebrow}
        </div>
        <h1 className="bd-h1" style={{ maxWidth: 1000 }}>
          {HERO.h1[0]}<br />
          <span style={{ color: "var(--bd-accent)" }}>{HERO.h1[1]}</span>
        </h1>
        <p style={{
          maxWidth: 620, marginTop: 28, fontSize: 19, lineHeight: 1.5,
          color: "var(--bd-fg-mute)"
        }}>
          {HERO.sub}
        </p>
        <div style={{ display: "flex", gap: 12, marginTop: 40 }}>
          <a href="#" onClick={(e) => { e.preventDefault(); window.Calendly && window.Calendly.initPopupWidget({ url: 'https://calendly.com/barnettdigital/discovery_call' }); }} className="bd-btn bd-btn-primary">Book a 30-min call →</a>
          <a className="bd-btn bd-btn-ghost">See how it works</a>
        </div>

        {/* Hero stat strip */}
        <div style={{
          marginTop: 96, display: "grid", gridTemplateColumns: "repeat(4, 1fr)",
          borderTop: "1px solid var(--bd-line)", borderBottom: "1px solid var(--bd-line)"
        }}>
          {[
          ["30 min", "Free strategy call"],
          ["4 wks", "To your first live automation"],
          ["Stackable", "More automations as you grow"],
          ["Ongoing", "Post-launch support & iteration"]].
          map(([n, l], i) =>
          <div key={i} style={{
            padding: "28px 24px",
            background: "var(--bd-bg-elev)",
            borderRight: i < 3 ? "1px solid var(--bd-line)" : "none"
          }}>
              <div style={{
              fontFamily: "var(--bd-font-display)", fontSize: 40, fontWeight: 600,
              letterSpacing: "-0.03em"
            }}>{n}</div>
              <div className="bd-mono" style={{ marginTop: 6 }}>{l}</div>
            </div>
          )}
        </div>
      </div>

      {/* PROBLEM */}
      <div id="work" className="bd-section" style={{ borderTop: "1px solid var(--bd-line)" }}>
        <div style={{ display: "grid", gridTemplateColumns: "320px 1fr", gap: 80 }}>
          <div>
            <div className="bd-mono">01 — The Problem</div>
            <h2 className="bd-h2" style={{ marginTop: 16 }}>
              Where your<br />week disappears.
            </h2>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 32, alignContent: "start" }}>
            {[
            {
              k: "Quoting",
              v: "6+ hours a week",
              d: "No structured follow-up sequence. Quotes go out, then sit cold while leads forget you and call the next sparkie."
            },
            {
              k: "Lead response",
              v: "7× less likely to win",
              d: "Leads not contacted within an hour are 7× less likely to convert (Harvard Business Review). The first business to reply wins."
            },
            {
              k: "Job admin",
              v: "Margin leaks every job",
              d: "Variations missed. Sign-offs forgotten. Invoices chased from the ute. The money's there — it just walks out the door."
            },
            {
              k: "Owner time",
              v: "2nd unpaid job",
              d: "You're back at the laptop at 9pm. The business runs you, not the other way around."
            }].
            map((c, i) =>
            <div key={i} style={{
              border: "1px solid var(--bd-line)", borderRadius: 12, padding: 24,
              background: "var(--bd-bg-elev)"
            }}>
                <div className="bd-mono">{c.k}</div>
                <div style={{
                fontFamily: "var(--bd-font-display)", fontSize: 32, fontWeight: 600,
                marginTop: 8, letterSpacing: "-0.02em",
                color: "var(--bd-warn)"
              }}>{c.v}</div>
                <div style={{ marginTop: 12, fontSize: 15, lineHeight: 1.5, color: "var(--bd-fg-mute)" }}>
                  {c.d}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      {/* HOW IT WORKS */}
      <div id="process" className="bd-section" style={{ background: "var(--bd-bg-elev)", borderTop: "1px solid var(--bd-line)" }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-end", marginBottom: 56 }}>
          <div>
            <div className="bd-mono">02 — How it works</div>
            <h2 className="bd-h2" style={{ marginTop: 16 }}>Three steps to your AI OS.</h2>
          </div>
          <div className="bd-mono">~6 weeks · fixed scope</div>
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 24 }}>
          {[
          {
            n: "01",
            t: "Audit",
            d: "A deep-dive call where I learn your business inside out. How jobs flow from quote to invoice. What slows you down. What software you use. What you'd fix first if you could. The more I understand, the sharper the plan.",
            tag: "Week 1"
          },
          {
            n: "02",
            t: "Plan",
            d: "I come back with a slideshow walking you through what I found, where the biggest wins are, and what I'd build first. You pick what we start with. One clear plan.",
            tag: "Week 2"
          },
          {
            n: "03",
            t: "Build",
            d: "Think of it like onboarding a new team member. First I build the foundations — everything the AI needs to know about your business, your jobs, your customers, the way you work. Once that's solid, I build the automations on top and plug them into your existing tools.",
            tag: "Weeks 3–4"
          }].
          map((s, i) =>
          <div key={i} style={{
            border: "1px solid var(--bd-line)",
            borderRadius: 16, padding: 32,
            background: "var(--bd-bg)",
            position: "relative",
            minHeight: 320
          }}>
              <div style={{
              fontFamily: "var(--bd-font-mono)", fontSize: 13,
              color: "var(--bd-accent)"
            }}>{s.n}</div>
              <h3 className="bd-h3" style={{ marginTop: 14 }}>{s.t}</h3>
              <p style={{ marginTop: 14, color: "var(--bd-fg-mute)", lineHeight: 1.55, fontSize: 15 }}>
                {s.d}
              </p>
              <div className="bd-mono" style={{
              position: "absolute", bottom: 24, left: 32,
              color: "var(--bd-fg-dim)"
            }}>{s.tag}</div>
            </div>
          )}
        </div>
      </div>

      {/* ROI / RESULTS */}
      <div className="bd-section" style={{ borderTop: "1px solid var(--bd-line)" }}>
        <div className="bd-mono">03 — What it's worth</div>
        <h2 className="bd-h2" style={{ marginTop: 16, maxWidth: 800 }}>
          We don't sell software.<br />We sell <span style={{ color: "var(--bd-accent)" }}>hours back</span>.
        </h2>
        <p style={{
          marginTop: 18, fontSize: 15, lineHeight: 1.5,
          color: "var(--bd-fg-mute)", maxWidth: 720, fontFamily: "var(--bd-font-mono)",
          letterSpacing: "0.01em",
        }}>
          Modelled from trade-industry benchmarks. Replaced with real client numbers as builds ship.
        </p>

        <div style={{
          marginTop: 40,
          display: "grid", gridTemplateColumns: "1fr 1fr", gap: 0,
          border: "1px solid var(--bd-line)", borderRadius: 16, overflow: "hidden"
        }}>
          {/* Before */}
          <div style={{ padding: 40, borderRight: "1px solid var(--bd-line)" }}>
            <div className="bd-mono">Today — typical NZ sparkie, 4 staff</div>
            <ul style={{ listStyle: "none", padding: 0, margin: "24px 0 0", display: "grid", gap: 14 }}>
              {[
              ["Quoting time", "11h / week"],
              ["Leads followed up < 1hr", "31%"],
              ["Owner laptop hours", "14h / week"],
              ["Job profit visibility", "End of month"]].
              map(([k, v], i) =>
              <li key={i} style={{ display: "flex", justifyContent: "space-between",
                borderBottom: "1px dashed var(--bd-line)", paddingBottom: 12, fontSize: 15 }}>
                  <span style={{ color: "var(--bd-fg-mute)" }}>{k}</span>
                  <span style={{ fontFamily: "var(--bd-font-mono)" }}>{v}</span>
                </li>
              )}
            </ul>
          </div>
          {/* After */}
          <div style={{ padding: 40, background: "color-mix(in oklab, var(--bd-accent) 6%, var(--bd-bg))" }}>
            <div className="bd-mono" style={{ color: "var(--bd-accent)" }}>The target — 90 days post-build</div>
            <ul style={{ listStyle: "none", padding: 0, margin: "24px 0 0", display: "grid", gap: 14 }}>
              {[
              ["Quoting time", "1.5h / week", "↓ 86%"],
              ["Leads followed up < 1hr", "94%", "↑ 3×"],
              ["Owner laptop hours", "3h / week", "↓ 11h back"],
              ["Job profit visibility", "Live, per job", "real-time"]].
              map(([k, v, delta], i) =>
              <li key={i} style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline",
                borderBottom: "1px dashed color-mix(in oklab, var(--bd-accent) 30%, transparent)", paddingBottom: 12, fontSize: 15 }}>
                  <span style={{ color: "var(--bd-fg-mute)" }}>{k}</span>
                  <span>
                    <span style={{ fontFamily: "var(--bd-font-mono)", marginRight: 12 }}>{v}</span>
                    <span className="bd-mono" style={{ color: "var(--bd-accent)" }}>{delta}</span>
                  </span>
                </li>
              )}
            </ul>
          </div>
        </div>

      </div>

      {/* ABOUT IVAN */}
      <div id="about" className="bd-section" style={{
        borderTop: "1px solid var(--bd-line)", background: "var(--bd-bg-elev)"
      }}>
        <div style={{ display: "grid", gridTemplateColumns: "420px 1fr", gap: 64, alignItems: "center" }}>
          <div style={{
            aspectRatio: "4/5", borderRadius: 16, overflow: "hidden",
            border: "1px solid var(--bd-line)",
            backgroundImage: "url('data:image/jpeg;base64,')",
            backgroundSize: "cover",
            backgroundPosition: "center 25%",
          }} aria-label="Portrait of Ivan Barnett" />
          <div>
            <div className="bd-mono">04 — The operator</div>
            <h2 className="bd-h2" style={{ marginTop: 16 }}>
              Ivan Barnett.<br />
              <span style={{ color: "var(--bd-fg-mute)" }}>20, Auckland, and that's the point.</span>
            </h2>
            <p style={{ marginTop: 28, fontSize: 18, lineHeight: 1.55, maxWidth: 620, color: "var(--bd-fg-mute)" }}>
              If you want to modernise your business, you hire someone who already lives in the
              modern world. I'm 20. I grew up with this technology. I use it every day. You're not
              paying me to figure AI out — I already know it inside out.
            </p>
            <p style={{ marginTop: 16, fontSize: 18, lineHeight: 1.55, maxWidth: 620, color: "var(--bd-fg-mute)" }}>
              I've been in trades for four years. I know what 70-hour weeks feel like. I know how
              hard running a business is — the late invoices, the stressful weeks, the quoting that
              eats your Sunday.
            </p>
            <p style={{ marginTop: 16, fontSize: 18, lineHeight: 1.55, maxWidth: 620, color: "var(--bd-fg-mute)" }}>
              Yes, 20 is young. But no one has more to prove — and no one moves faster — than a
              driven young guy at the start of something. I'm quitting my apprenticeship next week
              to go full-time on this. Focus is subtraction.
            </p>
            <div style={{
              marginTop: 32,
              padding: "20px 24px", borderLeft: "2px solid var(--bd-accent)",
              fontFamily: "var(--bd-font-editorial)", fontSize: 24, lineHeight: 1.3,
              fontStyle: "italic", maxWidth: 620
            }}>
              "You don't need a 45-year-old consultant in a $200 shirt. You need someone who lives in the tools, moves fast, and has everything to prove."
            </div>
          </div>
        </div>
      </div>

      {/* FINAL CTA */}
      <div id="cta" className="bd-grid-bg" style={{
        padding: "120px 64px",
        borderTop: "1px solid var(--bd-line)",
        textAlign: "left"
      }}>
        <div className="bd-mono">Free · 30 minutes · no pitch deck</div>
        <h2 className="bd-h2" style={{ marginTop: 16, fontSize: 80, lineHeight: 0.98, maxWidth: 1100 }}>
          Book a 30-minute call. Find out if there's something here.
        </h2>
        <p style={{ marginTop: 24, fontSize: 19, lineHeight: 1.55, color: "var(--bd-fg-mute)", maxWidth: 760 }}>
          No slides. No sales script. Just a quick chat — what your week looks like, where time's
          leaking, whether AI can actually help. If there's a fit, we talk about a paid audit. If
          there isn't, you've lost half an hour.
        </p>
        <div style={{ display: "flex", gap: 12, marginTop: 40, alignItems: "center" }}>
          <a href="#" onClick={(e) => { e.preventDefault(); window.Calendly && window.Calendly.initPopupWidget({ url: 'https://calendly.com/barnettdigital/discovery_call' }); }} className="bd-btn bd-btn-primary" style={{ fontSize: 16, padding: "18px 28px" }}>
            Book on Calendly →
          </a>
          <span className="bd-mono">or email <a href="mailto:office@flowstate.net.nz" style={{ color: "inherit", textDecoration: "underline" }}>office@flowstate.net.nz</a></span>
        </div>
      </div>

      {/* FOOTER */}
      <div style={{
        padding: "32px 64px",
        borderTop: "1px solid var(--bd-line)",
        display: "flex", justifyContent: "space-between",
        fontFamily: "var(--bd-font-mono)", fontSize: 12,
        color: "var(--bd-fg-dim)"
      }}>
        <div>FLOWSTATE · AUCKLAND, NZ</div>
        <div>© 2026 — built for trades, not for slide decks</div>
      </div>
    </div>);

};

window.V1 = V1;
</script>

<script type="text/babel" data-presets="react">
ReactDOM.createRoot(document.getElementById("root")).render(<V1 />);
</script>
</body>
</html>
